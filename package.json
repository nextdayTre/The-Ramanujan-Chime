    "mcp": "node agent/mcp-server.mjs",
    "selftest": "node agent/selftest.mjs",
    "verify:browser": "node agent/verify-browser.mjs",
    "serve": "python -m http.server 8080 --bind 127.0.0.1"
  }
}
